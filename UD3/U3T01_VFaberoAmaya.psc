Algoritmo U3T1_Fabero_Amaya_Victor
	
	Definir i Como Entero;
	
	Escribir "Los 20 primeros número naturales son:";
	
	Para i <- 1 Hasta 20 Con Paso 1 Hacer
		// Decidimos que i vale 1 en primer lugar y debe de llegar a 20 sumndole valores de 1 en 1.
		
		Escribir i;
		// Mostramos el valor momentáneo de i.
		
	FinPara
FinAlgoritmo
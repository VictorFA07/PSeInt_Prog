// U3T2: Ordinograma de un programa que muestre los números pares comprendidos entre el 1 y el 200
// Víctor Fabero Amaya
// 2026-10-08

Algoritmo U3T2_Fabero_Amaya_Victor_Mientras
	
	Definir num, rec_num Como Entero;
	
	num <- 2;
	rec_num <- 0;
	
	Mientras num <> 202 Hacer
		
		Escribir num;
		
		rec_num <- rec_num + 1;
		num <- num + 2;
		
	FinMientras
FinAlgoritmo
// U3T2: Ordinograma de un programa que muestre los números pares comprendidos entre el 1 y el 200
// Víctor Fabero Amaya
// 2026-10-08

Algoritmo U3T2_Fabero_Amaya_Victor_Para
	
	Definir n Como Entero;
	
	Escribir "Los números pares del 1 al 200 son:";
	
	Para n <- 2 Hasta 200 Con Paso 2 Hacer
		
		Escribir n;
		
	FinPara
FinAlgoritmo